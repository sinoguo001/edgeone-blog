{
  "outputDirectory": "public",
  "cloudFunctions": {
    "nodejs": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/admin/*",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "schedules": [
    {
      "name": "daily-backup",
      "cron": "0 3 * * *",
      "timezone": "Asia/Shanghai",
      "path": "/api/cron/backup",
      "method": "POST"
    }
  ]
}
